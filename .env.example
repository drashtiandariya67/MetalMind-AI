# MetalMind AI - Environment Variables
# Copy this file to .env and fill in your values

# Primary: GoldAPI.io (https://www.goldapi.io/)
EXPO_PUBLIC_GOLD_API_KEY=your_goldapi_key_here

# Fallback: Metals.dev (https://metals.dev/)
EXPO_PUBLIC_METALS_DEV_KEY=your_metalsdev_key_here

# Telegram Bot Notifications
EXPO_PUBLIC_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
EXPO_PUBLIC_TELEGRAM_CHAT_ID=your_telegram_chat_id

# Firebase (populated by google-services.json / GoogleService-Info.plist)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
